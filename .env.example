# Copy to .env for local development. On Vercel these go in
# Settings → Environment Variables instead — .env is not deployed.
#
# Anything WITHOUT a VITE_, EMAILJS_ or APP_URL prefix stays server-side:
# vite.config.js allowlists only those three for the browser bundle. Never add
# a PAYCHANGU_, TWILIO_ or FIREBASE_ADMIN_ name to that allowlist.

# ── PayChangu (server only) ──────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use sec-test-… until you have tested.
PAYCHANGU_SECRET_KEY=
# The webhook signing secret from the same screen.
PAYCHANGU_WEBHOOK_SECRET=
# Optional; defaults to https://api.paychangu.com
# PAYCHANGU_API_BASE=

# ── Firebase Admin (server only) ─────────────────────────────────────────────
# From the service-account JSON. Keep the private key on one line with the
# newlines written as \n — the SDK converts them back.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── WhatsApp — WaAPI (server only) ───────────────────────────────────────────
# waapi.app is an unofficial gateway (pairs a real WhatsApp number by QR code)
# — not Meta's Business Platform, so there is no Flow/template concept here.
# From waapi.app → your instance:
WAAPI_API_TOKEN=
WAAPI_INSTANCE_ID=
# A secret you invent yourself, embedded in the webhook URL you give WaAPI —
# see docs/whatsapp-waapi.md. WaAPI does not sign its webhook calls, so this
# is the only thing standing between /api/whatsapp/webhook and the internet.
WAAPI_WEBHOOK_TOKEN=
# Optional; defaults to https://waapi.app/api/v1
# WAAPI_API_BASE=

# ── Sign-in codes — api/auth/otp.js (server only) ────────────────────────────
# Mixed into the one-time-code hash so a leaked database of hashes alone isn't
# enough to brute-force a code. Any long random string; generate once and never
# change it (changing it invalidates every code in flight, which is harmless,
# but there's no reason to). If unset, a fixed fallback is used — fine for
# local dev, not for production.
OTP_PEPPER=

# ── Twilio (server only) ─────────────────────────────────────────────────────
TWILIO_ACC_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Preferred over the account auth token when present — an API key can be
# revoked on its own.
# TWILIO_API_SID=
# TWILIO_API_KEY=

# ── AI — Groq (server only) ──────────────────────────────────────────────────
# Powers both api/ai-insight.js (parent report-card insights) and
# api/ai-lesson-plan.js (AI-drafted lesson plans for teachers). Get a key at
# https://console.groq.com.
ACALINK_AI_API=
# Optional overrides — leave unset unless a deployment needs them:
# ACALINK_AI_MODEL=llama-3.3-70b-versatile        # used by ai-insight.js
# ACALINK_AI_LESSON_MODEL=llama-3.1-8b-instant    # used by ai-lesson-plan.js
# ACALINK_AI_REASONING_EFFORT=none   # only if MODEL is a reasoning model
# ACALINK_AI_REASONING_FORMAT=hidden
# ACALINK_AI_MAX_TOKENS=3072          # ai-insight.js budget
# ACALINK_AI_LESSON_MAX_TOKENS=700    # ai-lesson-plan.js budget

# ── Public (shipped in the browser bundle) ───────────────────────────────────
# Used to build the PayChangu callback and return URLs, and the login links in
# credential emails. No trailing slash.
APP_URL=https://ssp-pep.vercel.app
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=

# Copy to .env (gitignored by the root .gitignore's ".env" / ".env.*" rules —
# nothing extra needed here). Never commit real values.
#
# This file is read by both seed/seed.js (creates the tenant + these accounts)
# and scenes/*.js (logs in as them), so the passwords here ARE the accounts'
# passwords once you've run `npm run seed` — change here, then re-seed.

# ── Where to record against ──────────────────────────────────────────────────
# The AI (Groq) and payment (PayChangu) routes only exist as Vercel serverless
# functions — they are not served by the app's local `node server.js`. Record
# against the deployed app so those routes, and the PayChangu webhook, work.
BASE_URL=https://ssp-pep.vercel.app

# Local static server for the Flutter parent app's web build (demo/lib/serve-parent.js
# builds acalink/ for web and serves it here). Only needs to be reachable from
# this machine while recording.
PARENT_APP_URL=http://localhost:5050

# ── Firebase Admin (seed script only — never sent to the browser) ───────────
# Reuses the service-account file already in the repo root by default. Only
# set these if you want the seed script to use different credentials.
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=../ssp-pep-firebase-adminsdk-fbsvc-a71809ca23.json

# ── Demo tenant ───────────────────────────────────────────────────────────────
DEMO_SCHOOL_CODE=CHIKHO-DEMO
DEMO_SCHOOL_NAME=Chikho Community Day Secondary School

# ── Staff credentials (fixed emails per the brief; set your own passwords) ──
ADMIN_EMAIL=dyunimeet@dyuni.ac.mw
ADMIN_PASSWORD=
HEADTEACHER_EMAIL=milesknd@gmail.com
HEADTEACHER_PASSWORD=
TEACHER_EMAIL=claude@dyuni.ac.mw
TEACHER_PASSWORD=
BURSAR_EMAIL=kayleemiles62@gmail.com
BURSAR_PASSWORD=

# The guardian account used in scene 06 (parent app). The parent app logs in
# with phone + a per-guardian portal password (students.parentPortalPassword),
# not email/Firebase-Auth. Malawian E.164 format. The prefix decides which
# mobile money rail scene 06 reports the payment through: 099/098 = Airtel
# Money, 088/089/077 = TNM Mpamba (see PAYMENT_METHOD in scenes/06-fee-payment.js).
#
# CostWorth SPEC.md BLOCKING PREREQUISITE: the value below is a real, existing
# guardian account on the live Firebase project, not a fictional one. No
# CostWorth recording — of any scene, landscape or vertical, whether or not
# that scene touches the parent app — may run until this is replaced with a
# fictional phone/password (same convention as the other 27 seeded guardians
# in seed/roster.js) and GUARDIAN_ACCOUNT_CONFIRMED_FICTIONAL is set to true
# below. lib/preflight.js enforces this before every seed/scene run.
PARENT_PHONE=+265888606204
PARENT_PASSWORD=
GUARDIAN_ACCOUNT_CONFIRMED_FICTIONAL=false

# ── The one learner carried through scenes 03-05 ─────────────────────────────
# Set by the seed script; kept here so scene scripts don't have to query
# Firestore to find "the" demo learner.
DEMO_LEARNER_NAME=Chisomo Banda
DEMO_LEARNER_CLASS=Form 3A

# ── Recording ─────────────────────────────────────────────────────────────────
# "landscape" = the original 1920x1080 competition pipeline (default, unchanged).
# "vertical"  = CostWorth's 9:16 reshoot (810x1440 recording viewport — below
#               the app's 1024px responsive breakpoint, so it drives the real
#               mobile layout — delivered at 1080x1920). See lib/env.js.
RECORD_PROFILE=landscape

# Target length for a vertical scene (ignored by landscape scenes, which keep
# their own fixed competition-length pacing). One of 15/30/45/60.
CLIP_SECONDS=30

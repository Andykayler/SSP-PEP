{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/payments/*.js": {
      "maxDuration": 30
    },
    "api/whatsapp/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/ai-insight",
      "destination": "/api/ai?task=insight"
    },
    {
      "source": "/api/ai-lesson-plan",
      "destination": "/api/ai?task=lesson-plan"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
